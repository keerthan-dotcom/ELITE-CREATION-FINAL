# =============================================
# Elite Creations – Environment Variables
# =============================================
# Copy these into Netlify → Site Settings → Environment Variables
# (for Netlify Drop / CI builds)
# OR paste into a .env.local file for local development.

# ------- Supabase -------
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_SUPABASE_FUNCTIONS_URL=https://YOUR_PROJECT_ID.functions.supabase.co

# ------- Cloudinary (image uploads) -------
VITE_CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
VITE_CLOUDINARY_UPLOAD_PRESET=YOUR_CLOUDINARY_UPLOAD_PRESET

# ------- Razorpay -------
VITE_RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
